# --- gestão SaaS bloqueada nos domínios públicos (operador usa plataforma.jordaonetotech.com.br) ---
(protecaoSaas) {
	@saasGestao {
				path /api/saas/tenants /api/saas/tenants/* /api/saas/lojas /api/saas/lojas/* /api/saas/financeiro /api/saas/financeiro/* /api/saas/interesses /api/saas/interesses/* /api/saas/info /api/saas/dns /api/saas/dns/* /api/saas/resumo /api/saas/receita /api/saas/receita/*
	}
	handle @saasGestao {
		abort
	}
	@saasPlataformaEscrita {
		path /api/saas/plataforma
		not method GET
	}
	handle @saasPlataformaEscrita {
		abort
	}
	@pagGestao {
		path /saas-admin.html
	}
	handle @pagGestao {
		respond "Não encontrado" 404
	}
}

{
	email jordao@jordaonetotech.com.br
}



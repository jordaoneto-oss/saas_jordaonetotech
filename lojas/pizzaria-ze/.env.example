# Super Loja (Jordao Neto Tech) — variáveis de ambiente
# Copie para .env ou exporte no systemd/docker.

# Tenant servido quando o Host não indica nenhum (retrocompatível)
DEFAULT_TENANT=default-tenant
# Senha inicial de novas lojas (troque! nunca use o padrão em produção)
SEED_ADMIN_PASS=troque-esta-senha
# Token do superadmin SaaS (criar/listar lojas via /api/saas/tenants)
SAAS_ADMIN_TOKEN=gere-um-token-longo-aqui
# Porta/host
PORT=8324
HOST=127.0.0.1
# IP público da VPS (usado pelo superadmin p/ gerar instrução registro.br e verificar DNS)
PUBLIC_IP=131.57.12.10
# Domínio base da plataforma (wildcard *.BASE_DOMAIN -> mesma VPS)
BASE_DOMAIN=jordaonetotech.com.br
# Em produção, mantenha 0 para não imprimir senhas no log
SHOW_DEFAULT_PASS=0
